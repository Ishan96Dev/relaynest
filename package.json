{
  "name": "relaynest",
  "version": "0.1.0",
  "private": true,
  "description": "No-code Telegram bot builder and workflow automation platform.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,backend -c cyan,magenta --kill-others-on-fail \"pnpm dev:web\" \"pnpm dev:backend\"",
    "dev:3000": "concurrently -n web,backend -c cyan,magenta --kill-others-on-fail \"pnpm dev:web -- -H 127.0.0.1\" \"pnpm dev:backend\"",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:webpack": "next dev frontend -p 3000",
    "dev:backend": "tsx watch --clear-screen=false --include \"backend/**/*.ts\" --include \"supabase/templates/*.html\" backend/src/dev/status.ts",
    "dev:demo": "node scripts/dev-demo.cjs",
    "images": "node scripts/optimize-images.mjs",
    "models:sql": "tsx scripts/build-model-seed.ts",
    "emails": "node --env-file-if-exists=.env scripts/build-email-templates.mjs",
    "emails:logo": "node --env-file-if-exists=.env scripts/upload-email-logo.mjs",
    "auth:config": "node --env-file=.env scripts/apply-auth-config.mjs",
    "build": "next build frontend",
    "start": "next start frontend",
    "lint": "eslint frontend/src backend/src backend/tests",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "audit:compliance": "node scripts/security-a11y-audit.mjs",
    "test": "tsx --tsconfig frontend/tsconfig.json --conditions react-server --test backend/tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@xyflow/react": "^13.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/env": "15.5.29",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
