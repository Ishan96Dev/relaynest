# App
NEXT_PUBLIC_APP_NAME=RelayNest
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only secret key
SUPABASE_SECRET_KEY=

# 32 bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1

# AI model providers (server-only). NVIDIA Build: https://build.nvidia.com  |  Vercel AI Gateway: https://vercel.com/ai-gateway
NVIDIA_API_KEY=
AI_GATEWAY_API_KEY=

# Telegram
TELEGRAM_API_BASE_URL=https://api.telegram.org
# auto = webhook when NEXT_PUBLIC_APP_URL is https, otherwise the dev server polls Telegram (no tunnel needed). Values: auto | polling | webhook
TELEGRAM_UPDATES_MODE=auto

LOG_LEVEL=debug

# Auth setup (used only by pnpm auth:config, never by the app)
SUPABASE_ACCESS_TOKEN=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=RelayNest
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Knowledge Base vector database (Milvus or Zilliz Cloud). Optional: without MILVUS_URI the Knowledge Base uses keyword search.
# Self-hosted: http://localhost:19530 (token "root:Milvus"). Zilliz Cloud: the Public Endpoint and an API key.
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION=relaynest_knowledge

# ---------------------------------------------------------------------------
# Razorpay (billing). Dashboard > Settings > API Keys; webhook secret: Settings > Webhooks.
# Use rzp_test_ keys while testing. Keys must be from the same mode (test or live) as the webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Brevo transactional email (app emails: receipts, failure alerts, account deletion confirmation). Brevo > SMTP & API > API Keys.
# The BREVO_SMTP_* values above are for Supabase Auth emails (verify, reset password, reauthentication, security alerts).
BREVO_API_KEY=
# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Public, safe in the browser. Needs a rebuild/restart to change.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Secret that protects POST /api/cron/tick (the automation scheduler). Any long random string.
CRON_SECRET=
# Set to true to run the scheduler inside a production `next start` process (it always runs in dev). Leave empty on Cloudflare.
SCHEDULER_IN_PROCESS=
# Comma-separated emails allowed to see the shared Vercel AI Gateway balance on the Analytics page.
PLATFORM_ADMIN_EMAILS=
# Optional NVIDIA prices in USD per million tokens. NVIDIA Build is a free trial tier, so leave empty to count it as $0.
NVIDIA_PRICE_INPUT_PER_MTOK=
NVIDIA_PRICE_OUTPUT_PER_MTOK=
# Platform Admin Console (/admin) - single owner only
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional PBKDF2 hash instead of plaintext ADMIN_PASSWORD (recommended in production)
ADMIN_PASSWORD_HASH=


# Redis + Kafka (HTTP REST, Cloudflare Workers compatible; optional locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_USERNAME=
UPSTASH_KAFKA_REST_PASSWORD=
KAFKA_TOPIC_PREFIX=relaynest
KAFKA_CONSUMER_SECRET=

