{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaynest",
  "main": "frontend/.open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "frontend/.open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
