{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaynest",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "frontend/.open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/video/*"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "relaynest"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAYNEST_STATE",
        "class_name": "RelayNestState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayNestState"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RELAYNEST_QUEUE",
        "queue": "relaynest-events"
      }
    ],
    "consumers": [
      {
        "queue": "relaynest-events",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 5,
        "max_concurrency": 5,
        "dead_letter_queue": "relaynest-events-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
